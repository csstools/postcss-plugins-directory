{
	"name": "postcss-comments",
	"version": "2.0.0",
	"description": "Postcss plugin to prepend or append comments to CSS rules",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/elchininet/postcss-comments.git"
	},
	"author": {
		"name": "ElChiniNet"
